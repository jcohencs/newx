---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<BaseLayout title="Blog — Joshua Cohen" description="Notes on IT, IoT, game dev, and the Pokémon TCG meta.">
  <header class="mx-auto max-w-[720px] px-5 pt-24 pb-10 sm:px-10 sm:pt-28">
    <div class="mb-3 text-[11px] font-medium uppercase tracking-wider" style="color: var(--muted);">Joshua Cohen</div>
    <h1 class="mb-3 text-[clamp(30px,7vw,56px)] leading-tight tracking-tight" style="font-family: var(--font-serif);">
      The <em class="italic" style="color: var(--text2);">Blog</em>
    </h1>
    <p class="text-sm font-light leading-relaxed" style="color: var(--text2);">
      Notes on things I'm building, learning, and thinking about — from IoT and IT to Pokémon TCG and everything in between.
    </p>
  </header>
  <div class="relative z-10 mx-auto h-[0.5px] max-w-[720px]" style="background: var(--border);"></div>

  <main class="mx-auto max-w-[720px] px-5 pt-14 pb-28 sm:px-10">
    <div class="flex flex-col gap-3">
      {posts.map((post) => (
        <article class="card p-7">
          <div class="mb-2 flex items-start justify-between gap-4">
            <div class="text-[11px]" style="color: var(--muted);">{dateFmt(post.data.date)}</div>
            <span class="pill">{post.data.tag}</span>
          </div>
          <a href={`${base}/blog/${post.id}/`} class="mb-2 block text-xl no-underline transition-colors" style="font-family: var(--font-serif); letter-spacing: -0.3px; color: var(--text);">
            {post.data.title}
          </a>
          <p class="mb-4 text-[13.5px] leading-relaxed" style="color: var(--text2);">{post.data.excerpt}</p>
          <a href={`${base}/blog/${post.id}/`} class="inline-flex items-center gap-1 text-xs font-medium no-underline transition-all" style="color: var(--text2);">
            Read post <i class="ti ti-arrow-right text-[13px]" aria-hidden="true"></i>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
