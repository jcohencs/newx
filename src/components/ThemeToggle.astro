---

<button
  class="theme-toggle relative h-[26px] w-12 flex-shrink-0 cursor-pointer border-none bg-transparent p-0"
  id="theme-toggle"
  aria-label="Toggle light/dark mode"
>
  <div class="glass flex h-[26px] w-12 items-center rounded-full">
    <div class="relative z-10 flex w-full justify-between px-[6px] text-[10px] pointer-events-none">
      <span class="icon-sun leading-none opacity-40" data-theme-dark-opacity="0.15" data-theme-light-opacity="0.7">☀️</span>
      <span class="icon-moon leading-none opacity-40" data-theme-dark-opacity="0.7" data-theme-light-opacity="0.15">🌙</span>
    </div>
    <div
      id="theme-toggle-thumb"
      class="absolute left-[3px] flex h-5 w-5 items-center justify-center rounded-full text-[11px] transition-transform duration-250"
      style="background: var(--text2); transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background 0.25s;"
    >
    </div>
  </div>
</button>

<script>
  function applyTheme(theme: string) {
    const html = document.documentElement;
    html.setAttribute('data-theme', theme);
    const thumb = document.getElementById('theme-toggle-thumb');
    const sun = document.querySelector<HTMLElement>('.icon-sun');
    const moon = document.querySelector<HTMLElement>('.icon-moon');
    if (thumb) {
      thumb.style.transform = theme === 'light' ? 'translateX(22px)' : 'translateX(0)';
      thumb.style.background = theme === 'light' ? 'var(--text)' : 'var(--text2)';
    }
    if (sun) sun.style.opacity = theme === 'light' ? '0.7' : '0.15';
    if (moon) moon.style.opacity = theme === 'light' ? '0.15' : '0.7';
  }

  function init() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    applyTheme(document.documentElement.getAttribute('data-theme') || 'dark');
    btn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
