---
import SectionHeader from './SectionHeader.astro';
import { experience } from '../lib/data';
---

<section class="section mb-16" id="experience">
  <SectionHeader num="01" title="Experience" />
  <div class="flex flex-col gap-2.5">
    {experience.map((job) => (
      <div class="card p-6">
        <div class="mb-1 flex flex-col items-start justify-between gap-1.5 sm:flex-row sm:items-start">
          <h3 class="text-lg tracking-tight" style="font-family: var(--font-serif);">{job.title}</h3>
          <span class="pill flex-shrink-0">{job.badge}</span>
        </div>
        <div class="mb-4 flex flex-wrap items-center gap-1.5 text-xs" style="color: var(--muted);">
          <span>{job.org}</span>
          {job.context && (<><span class="inline-block h-[3px] w-[3px] rounded-full" style="background: var(--muted);"></span><span>{job.context}</span></>)}
          {job.period && (<><span class="inline-block h-[3px] w-[3px] rounded-full" style="background: var(--muted);"></span><span>{job.period}</span></>)}
        </div>
        <ul class="bullet-list flex flex-col gap-1.5">
          {job.bullets.map((b) => (
            <li class="text-[13.5px] leading-relaxed" style="color: var(--text2);">{b}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
