---
import SectionHeader from './SectionHeader.astro';
import { certifications } from '../lib/data';
---

<section class="section mb-16">
  <SectionHeader num="05" title="Certifications" />
  <div class="flex flex-col gap-2">
    {certifications.map((cert) => (
      <div class="card flex items-center gap-3 rounded-xl px-5 py-3.5">
        <i class={`ti ${cert.icon} flex-shrink-0 text-lg`} style="color: var(--text2);" aria-hidden="true"></i>
        <div class="flex-1">
          <div class="text-[13.5px] font-medium">{cert.name}</div>
          {cert.id && <div class="text-[11px]" style="color: var(--muted);">{cert.id}</div>}
        </div>
        {cert.date && <span class="pill">{cert.date}</span>}
      </div>
    ))}
  </div>
</section>
