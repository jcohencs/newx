<script>
  (function () {
    const canvasEl = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
    if (!canvasEl) return;
    const canvas = canvasEl;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let W = 0,
      H = 0,
      animId = 0;
    const COUNT = 120;
    type P = { x: number; y: number; vx: number; vy: number; r: number; alpha: number; drift: number; driftSpeed: number };
    const particles: P[] = [];

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function getColor() {
      return getComputedStyle(document.documentElement).getPropertyValue('--particle-color').trim() || '255,255,255';
    }

    function initParticles() {
      particles.length = 0;
      for (let i = 0; i < COUNT; i++) {
        particles.push({
          x: rand(0, W),
          y: rand(0, H),
          vx: rand(-0.15, 0.15),
          vy: rand(-0.2, -0.05),
          r: rand(0.8, 2.0),
          alpha: rand(0.07, 0.3),
          drift: rand(0, Math.PI * 2),
          driftSpeed: rand(0.002, 0.007),
        });
      }
    }

    function resize() {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
      initParticles();
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      const co = getColor();
      const maxDist = 130;
      particles.forEach((p) => {
        p.drift += p.driftSpeed;
        p.x += p.vx + Math.sin(p.drift) * 0.1;
        p.y += p.vy;
        if (p.y < -4) p.y = H + 4;
        if (p.x < -4) p.x = W + 4;
        if (p.x > W + 4) p.x = -4;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${co},${p.alpha})`;
        ctx.fill();
      });
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i],
            b = particles[j],
            dx = a.x - b.x,
            dy = a.y - b.y,
            d2 = dx * dx + dy * dy;
          if (d2 < maxDist * maxDist) {
            const d = Math.sqrt(d2);
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${co},${(1 - d / maxDist) * 0.07})`;
            ctx.lineWidth = 0.5;
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      animId = requestAnimationFrame(draw);
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    resize();
    window.addEventListener('resize', () => {
      cancelAnimationFrame(animId);
      resize();
      if (!prefersReducedMotion) draw();
    });
    if (!prefersReducedMotion) draw();
  })();
</script>
